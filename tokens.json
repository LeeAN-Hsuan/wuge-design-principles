{
  "$description": "Wuge Studio design tokens (W3C Design Tokens Community Group format). Principles referenced by id: see /principles.json.",
  "color": {
    "ink":       {"$type": "color", "$value": "#121212", "$description": "Text and primary field."},
    "paper":     {"$type": "color", "$value": "#F2EEE6", "$description": "Background. Warm, not grey."},
    "vermilion": {"$type": "color", "$value": "#E8401C", "$description": "The single event colour. One use per view (WG-10)."},
    "grid":      {"$type": "color", "$value": "#2340D8", "$description": "Links and alignment guides. Bold colour is allowed (WG-01)."},
    "rule":      {"$type": "color", "$value": "#121212", "$description": "Hairlines; use at 15% opacity on paper."}
  },
  "module": {
    "U": {"$type": "dimension", "$value": "12px", "$description": "Base module = stroke width. Gaps and radii take multiples of U/2 (WG-11)."}
  },
  "space": {
    "half": {"$type": "dimension", "$value": "6px"},
    "1":    {"$type": "dimension", "$value": "12px"},
    "2":    {"$type": "dimension", "$value": "24px"},
    "4":    {"$type": "dimension", "$value": "48px"},
    "8":    {"$type": "dimension", "$value": "96px"}
  },
  "typeScale": {
    "$description": "Skeleton, not ceiling (WG-05). Print values in pt; screen values in px.",
    "print": {
      "title":    {"$type": "dimension", "$value": "24pt"},
      "subtitle": {"$type": "dimension", "$value": "17pt"},
      "body":     {"$type": "dimension", "$value": "10pt"},
      "note":     {"$type": "dimension", "$value": "8pt"}
    },
    "screen": {
      "display":  {"$type": "dimension", "$value": "clamp(48px, 11vw, 144px)", "$description": "Showcase only; may crop or overlap (WG-07)."},
      "title":    {"$type": "dimension", "$value": "32px"},
      "body":     {"$type": "dimension", "$value": "17px"},
      "note":     {"$type": "dimension", "$value": "13px"}
    }
  },
  "font": {
    "latin":   {"$type": "fontFamily", "$value": ["Inter", "Helvetica Neue", "Arial", "sans-serif"]},
    "zh":      {"$type": "fontFamily", "$value": ["Noto Sans TC", "PingFang TC", "sans-serif"]},
    "mono":    {"$type": "fontFamily", "$value": ["JetBrains Mono", "ui-monospace", "monospace"]}
  },
  "radius": {
    "none":  {"$type": "dimension", "$value": "0px", "$description": "Default. Frames are square."},
    "small": {"$type": "dimension", "$value": "6px", "$description": "U/2; at least 2–3 radius levels when a mark uses curves (WG-13)."},
    "large": {"$type": "dimension", "$value": "18px"}
  }
}
